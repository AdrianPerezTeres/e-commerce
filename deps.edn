{:paths ["src/clj" "resources"]

 :deps {ring/ring-core                {:mvn/version "1.12.2"}
        ring/ring-jetty-adapter       {:mvn/version "1.12.2"}
        ring/ring-json                {:mvn/version "0.5.1"}
        metosin/reitit-ring           {:mvn/version "0.7.2"}
        metosin/reitit-middleware      {:mvn/version "0.7.2"}
        metosin/reitit-spec           {:mvn/version "0.7.2"}
        ring-cors/ring-cors           {:mvn/version "0.1.13"}
        metosin/muuntaja              {:mvn/version "0.6.10"}

        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        org.postgresql/postgresql      {:mvn/version "42.7.4"}
        com.zaxxer/HikariCP           {:mvn/version "6.0.0"}
        migratus/migratus              {:mvn/version "1.5.8"}

        org.clojure/data.csv           {:mvn/version "1.1.0"}

        buddy/buddy-sign               {:mvn/version "3.6.1-359"}

        ch.qos.logback/logback-classic {:mvn/version "1.5.8"}
        org.clojure/tools.logging      {:mvn/version "1.3.0"}

        org.clojure/clojure            {:mvn/version "1.12.0"}
        mount/mount                    {:mvn/version "0.1.19"}
        aero/aero                      {:mvn/version "1.1.6"}}

 :aliases
 {:dev   {:extra-paths ["dev" "test/clj" "src/cljs"]
          :extra-deps  {thheller/shadow-cljs                   {:mvn/version "2.28.20"}
                        reagent/reagent                        {:mvn/version "1.2.0"}
                        re-frame/re-frame                      {:mvn/version "1.4.3"}
                        metosin/reitit-frontend                {:mvn/version "0.7.2"}
                        org.clojure/tools.namespace             {:mvn/version "1.5.0"}
                        nrepl/nrepl                            {:mvn/version "1.3.0"}
                        cider/cider-nrepl                      {:mvn/version "0.50.2"}}}

  :test  {:extra-paths ["test/clj"]
          :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                        lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}}

  :build {:deps  {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}

  :run   {:main-opts ["-m" "ecommerce.core"]}

  :migrate {:main-opts ["-m" "ecommerce.db.migrations"]}}}
