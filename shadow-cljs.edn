{:nrepl {:port 7002}

 :deps {:aliases [:dev]}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"

   :modules
   {:main {:init-fn ecommerce.core/init}}

   :devtools
   {:http-root    "resources/public"
    :http-port    3000
    :watch-dir    "resources/public"
    :repl-pprint  true}}

  :test
  {:target    :node-test
   :output-to "out/test/test.js"
   :ns-regexp "-test$"}}}
